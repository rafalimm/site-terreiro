# Copie para ".env" (desenvolvimento) e configure também na hospedagem do front-end (produção).

# Endereço da API backend.
# Em desenvolvimento local (rodando o backend com "npm run dev" na pasta backend/):
VITE_API_URL="http://localhost:3333"

# Em produção, troque para o endereço real da API assim que ela estiver hospedada, ex:
# VITE_API_URL="https://api.seusite.com.br"
