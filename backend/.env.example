# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" de verdade para o Git.

# String de conexão do PostgreSQL.
# Em produção (Railway/Render/Supabase/etc.) essa variável é fornecida pelo próprio provedor.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/terreiro?schema=public"

# Segredo usado para assinar os tokens de login (JWT).
# Gere um valor aleatório e longo, por exemplo com: openssl rand -base64 48
JWT_SECRET="troque-isto-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN="7d"

# Porta em que a API vai rodar (a maioria das hospedagens define isso sozinha em produção)
PORT=3333

# Endereço(s) do front-end que podem acessar a API (separados por vírgula se houver mais de um).
# Em desenvolvimento local:
FRONTEND_URL="http://localhost:5173"
# Em produção, troque para o domínio real assim que ele estiver no ar, por exemplo:
# FRONTEND_URL="https://www.seusite.com.br,https://seusite.com.br"
